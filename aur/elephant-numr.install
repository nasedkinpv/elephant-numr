post_install() {
    echo ""
    echo "==> Add 'numr' to ~/.config/walker/config.toml providers."
    echo "==> Optional setup helpers:"
    echo "==>   /usr/share/elephant/numr/configure-walker.sh"
    echo "==>   /usr/share/elephant/numr/configure-theme.sh"
    echo "==> Restart elephant: systemctl --user restart elephant"
    echo ""
}

post_upgrade() {
    post_install
}
